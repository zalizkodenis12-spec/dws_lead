# ============================================================
# DWS Lead — Конфігураційний файл середовища (.env)
# DenisWeb Studio · Lead Bot & Telegram Mini App
# ============================================================

# 1. ПОРТ СЕРВЕРА
PORT=3000

# 2. TELEGRAM BOT (Основний бот для кнопки WebApp та сповіщень)
# Отримайте токен бота через @BotFather у Telegram:
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Посилання на розміщений Mini App (для локального тестування можна через ngrok/localtunnel або Vercel):
# Наприклад: https://your-domain.vercel.app або https://abc123.ngrok-free.app
TELEGRAM_APP_URL=http://localhost:3000

# Ваш особистий Telegram Chat ID для отримання гарячих лідів (дізнайтеся через @userinfobot):
TELEGRAM_CHAT_ID=your_telegram_chat_id_here


# 3. ШТУЧНИЙ ІНТЕЛЕКТ (AI) — ЕКОНОМНИЙ РЕЖИМ (ON-DEMAND)
# ------------------------------------------------------------
# 💡 ЯК ПІДКЛЮЧИТИ GOOGLE AI / GOOGLE AI PLUS:
# Якщо у вас є підписка Google One / Google AI Plus:
# 1. Зайдіть на https://aistudio.google.com/app/apikey (під вашим Google акаунтом)
# 2. Натисніть "Create API key"
# 3. Скопіюйте ключ та вставте сюди:
GEMINI_API_KEY=your_gemini_api_key_here

# Модель Gemini (рекомендовано gemini-1.5-flash — швидка, точна та безкоштовна в AI Studio):
GEMINI_MODEL=gemini-1.5-flash


# 4. TELEGRAM MTPROTO ПАРСЕР (~200 ЧАТІВ ТА ~200 КАНАЛІВ)
# ------------------------------------------------------------
# Потрібно для юзербота, який у фоні читає повідомлення з 400 чатів/каналів:
# Отримайте api_id та api_hash на офіційному сайті https://my.telegram.org -> API development tools:
TELEGRAM_API_ID=your_telegram_api_id_here
TELEGRAM_API_HASH=your_telegram_api_hash_here

# Рядок сесії (створюється автоматично при першому вході за номером телефону):
TELEGRAM_SESSION_STRING=
