{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/leads/scan", "destination": "/api/leads/scan" },
    { "source": "/api/leads", "destination": "/api/leads" },
    { "source": "/api/leads/(.*)", "destination": "/api/leads/$1" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/miniapp/$1" }
  ]
}
