{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/leads.json", "destination": "/miniapp/api/leads.json" },
    { "source": "/api/leads", "destination": "/miniapp/api/leads.json" },
    { "source": "/api/leads/scan", "destination": "/miniapp/api/leads.json" },
    { "source": "/(.*)", "destination": "/miniapp/$1" }
  ]
}
