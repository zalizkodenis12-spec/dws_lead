{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/(.*).json",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/nfc-outreach", "destination": "/api/nfc-outreach.js" },
    { "source": "/api/leads/scan", "destination": "/api/scan.js" },
    { "source": "/api/cron-scan", "destination": "/api/scan.js?report=1" },
    { "source": "/api/proxy", "destination": "/api/proxy.js" },
    { "source": "/api/leads(.*)", "destination": "/miniapp/leads-data.json" },
    { "source": "/leads-data.json", "destination": "/miniapp/leads-data.json" },
    { "source": "/(.*)", "destination": "/miniapp/$1" }
  ],
  "crons": [
    {
      "path": "/api/cron-scan",
      "schedule": "0 21 * * *"
    }
  ]
}
